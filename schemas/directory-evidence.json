{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://folder-intelligence.org/schemas/directory-evidence.json",
  "title": "Directory Evidence",
  "description": "Schema for directory evidence collected by folder-intelligence v2.0. Evidence represents observed facts about the filesystem without semantic interpretation.",
  "type": "object",
  "required": [
    "path",
    "name",
    "parent_path",
    "depth",
    "file_count",
    "directory_count",
    "total_size",
    "extension_histogram",
    "dominant_extensions",
    "identifier_summary",
    "child_directory_names",
    "filename_sample",
    "notable_filenames",
    "syntactic_identifiers",
    "text_file_presence",
    "is_empty",
    "partial_scan",
    "scanned_at",
    "scan_duration_ms",
    "schema_version"
  ],
  "properties": {
    "path": {
      "type": "string",
      "description": "Absolute path of the directory"
    },
    "name": {
      "type": "string",
      "description": "Name of the directory (last component of path)"
    },
    "parent_path": {
      "type": ["string", "null"],
      "description": "Parent directory path (null for root)"
    },
    "depth": {
      "type": "integer",
      "minimum": 0,
      "description": "Depth from scan root (0 = root directory)"
    },
    "file_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of files directly in this directory"
    },
    "directory_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of subdirectories directly in this directory"
    },
    "total_size": {
      "type": "integer",
      "minimum": 0,
      "description": "Total size of direct files in this directory in bytes (not recursive)"
    },
    "extension_histogram": {
      "type": "object",
      "description": "Histogram of file extensions (lowercase, without dot)",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "dominant_extensions": {
      "type": "array",
      "description": "Top extensions by frequency, with counts and percentages",
      "items": {
        "$ref": "#/$defs/dominant_extension"
      }
    },
    "identifier_summary": {
      "$ref": "#/$defs/identifier_summary"
    },
    "child_directory_names": {
      "type": "array",
      "description": "Names of immediate child directories (bounded by max_child_dirs limit)",
      "items": {
        "type": "string"
      }
    },
    "filename_sample": {
      "type": "array",
      "description": "Bounded sample of filenames from this directory (renamed from representative_filenames)",
      "items": {
        "type": "string"
      }
    },
    "notable_filenames": {
      "type": "array",
      "description": "Common/special filenames observed (README, LICENSE, etc.)",
      "items": {
        "type": "string"
      }
    },
    "syntactic_identifiers": {
      "type": "array",
      "description": "Syntactic identifiers extracted from filenames (renamed from potential_identifiers; no semantic meaning assigned)",
      "items": {
        "$ref": "#/$defs/syntactic_identifier"
      }
    },
    "text_file_presence": {
      "$ref": "#/$defs/text_file_presence"
    },
    "is_empty": {
      "type": "boolean",
      "description": "True when file_count == 0 AND directory_count == 0"
    },
    "partial_scan": {
      "type": "boolean",
      "description": "Whether this evidence was collected during a partial/truncated scan (incomplete)"
    },
    "scanned_at": {
      "type": "integer",
      "minimum": 0,
      "description": "Scan timestamp (Unix epoch seconds)"
    },
    "scan_duration_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Duration of scan for this directory in milliseconds"
    },
    "schema_version": {
      "type": "string",
      "description": "Schema version identifier (e.g. '2.0.0')"
    }
  },
  "$defs": {
    "dominant_extension": {
      "type": "object",
      "required": ["extension", "count", "percentage"],
      "properties": {
        "extension": {
          "type": "string",
          "description": "File extension (lowercase, without dot) or '(no extension)'"
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of files with this extension in the directory"
        },
        "percentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Percentage of files with this extension (0.0 if file_count is 0)"
        }
      }
    },
    "identifier_summary": {
      "type": "object",
      "required": ["total", "by_type"],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of syntactic identifiers found across all filenames"
        },
        "by_type": {
          "type": "object",
          "description": "Count of identifiers per identifier type",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "syntactic_identifier": {
      "type": "object",
      "required": ["value", "source_filename", "identifier_type"],
      "properties": {
        "value": {
          "type": "string",
          "description": "The identifier string found"
        },
        "source_filename": {
          "type": "string",
          "description": "Source filename it was extracted from"
        },
        "identifier_type": {
          "$ref": "#/$defs/identifier_type"
        }
      }
    },
    "identifier_type": {
      "type": "string",
      "enum": [
        "isbn",
        "doi",
        "uuid",
        "semver",
        "hash",
        "date",
        "alphanumeric_code",
        "email",
        "url",
        "custom"
      ],
      "description": "Type of identifier pattern matched"
    },
    "text_file_presence": {
      "type": "object",
      "required": [
        "has_readme",
        "has_nfo",
        "has_txt",
        "has_md",
        "has_license",
        "has_changelog",
        "text_files_found"
      ],
      "properties": {
        "has_readme": {
          "type": "boolean",
          "description": "Whether a README file exists (any case, any extension)"
        },
        "has_nfo": {
          "type": "boolean",
          "description": "Whether an NFO file exists"
        },
        "has_txt": {
          "type": "boolean",
          "description": "Whether any .txt files exist"
        },
        "has_md": {
          "type": "boolean",
          "description": "Whether any .md files exist"
        },
        "has_license": {
          "type": "boolean",
          "description": "Whether a LICENSE file exists"
        },
        "has_changelog": {
          "type": "boolean",
          "description": "Whether a CHANGELOG file exists"
        },
        "text_files_found": {
          "type": "array",
          "description": "List of text file names found",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
